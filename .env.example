# Copy this file to .env — and never commit .env.

# Claude: only needed if you have NOT run `ant auth login`.
# ANTHROPIC_API_KEY=

# PostgreSQL: remove the # to keep episodes and progress in the database started by `docker compose up -d`.
# Without this line the app reads the episode folders and keeps progress in data/store.json.
# ATELIER_DB=postgresql://atelier:atelier@localhost:5433/atelier

# Links under the videos of a YouTube playlist (python import_liens.py). A free key of the YouTube Data API v3, from Google Cloud.
# YOUTUBE_API_KEY=
